# Direct Postgres connection used SERVER-SIDE only (never shipped to the browser).
# PRODUCTION (see deploy/env.example + deploy/README.md): use the least-privileged `kevbox_admin`
# role (NOT postgres) via the Supabase **Session pooler** host (IPv4-reachable; the direct
# db.<project>.supabase.co host is IPv6-only). Local dev can use any reachable connection string.
SUPABASE_DB_URL=postgres://kevbox_admin.<project>:password@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require

# Used to verify the admin's Supabase JWT (auth.getUser). The anon key is public-safe.
SUPABASE_URL=https://<project>.supabase.co
SUPABASE_ANON_KEY=<anon-public-key>

# Comma-separated allowlist of admin emails. Authenticated users NOT in this list are rejected.
ADMIN_EMAILS=kevin.chiha@gmail.com

# Local port nginx reverse-proxies admin.kevbox.dev to.
PORT=8787
